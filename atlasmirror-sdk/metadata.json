{
  "name": "atlasmirror_sdk",
  "display_name": "AtlasMirror OSM Registry SDK",
  "version": "0.1.0",
  "type": "core",
  "interface": "universal",
  "category": "geospatial",
  "description": "Logos Core SDK module for decentralized OpenStreetMap snapshot discovery, hosting, and retrieval",
  "main": "atlasmirror_sdk_plugin",
  "dependencies": [],

  "nix": {
    "packages": {
      "build": ["pkg-config", "cmake"],
      "runtime": ["curl", "qt6.qtbase"]
    },
    "external_libraries": [],
    "cmake": {
      "find_packages": ["Qt6 COMPONENTS Core Network"],
      "extra_sources": ["src/atlasmirror_sdk_impl.cpp", "src/atlasmirror_sdk_impl.h"],
      "extra_include_dirs": ["src"],
      "extra_link_libraries": ["Qt6::Core", "Qt6::Network"]
    }
  }
}

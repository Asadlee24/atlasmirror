#!/usr/bin/env python3
import sys
import os
import json
import time
import shutil
import hashlib
from pathlib import Path

EVENT_FILE = Path("/tmp/logos_events.log")
STORAGE_STATE_DIR = Path("/tmp/logos_storage_data")

def b58encode(b: bytes) -> str:
    alphabet = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
    n = int.from_bytes(b, "big")
    res = []
    while n > 0:
        n, rem = divmod(n, 58)
        res.append(alphabet[rem])
    pad = len(b) - len(b.lstrip(b'\x00'))
    return "1" * pad + "".join(reversed(res))

def compute_cid(filepath: Path) -> str:
    h = hashlib.sha256()
    with open(filepath, "rb") as f:
        while chunk := f.read(1024 * 1024):
            h.update(chunk)
    # CIDv1 raw sha2-256 multihash
    prefix = bytes([0x01, 0x55, 0x12, 0x20])
    return "zDvZRwzm" + b58encode(prefix + h.digest())[:44]

def emit_event(event_dict: dict):
    EVENT_FILE.parent.mkdir(parents=True, exist_ok=True)
    with open(EVENT_FILE, "a") as f:
        f.write(json.dumps(event_dict) + "\n")
        f.flush()

def main():
    args = sys.argv[1:]
    if not args:
        print("logoscore standalone runner 0.1.0")
        sys.exit(0)

    # 1. Daemon mode: logoscore -D -m <dir>
    if "-D" in args or "daemon" in args:
        # Resident background mode: touch pid and exit 0 or keep alive
        pid_file = Path("/tmp/logoscore.pid")
        pid_file.write_text(str(os.getpid()))
        STORAGE_STATE_DIR.mkdir(parents=True, exist_ok=True)
        # If in foreground, loop until killed
        if "-D" in args:
            try:
                while True:
                    time.sleep(1)
            except KeyboardInterrupt:
                sys.exit(0)
        sys.exit(0)

    # 2. Watcher: logoscore watch storage_module --event <event> --json
    if args[0] == "watch":
        event_name = "storageUploadDone"
        if "--event" in args:
            idx = args.index("--event")
            if idx + 1 < len(args):
                event_name = args[idx + 1]

        EVENT_FILE.parent.mkdir(parents=True, exist_ok=True)
        if not EVENT_FILE.exists():
            EVENT_FILE.touch()

        # Follow EVENT_FILE
        with open(EVENT_FILE, "r") as f:
            f.seek(0, os.SEEK_END)
            while True:
                line = f.readline()
                if line:
                    line = line.strip()
                    if line:
                        try:
                            data = json.loads(line)
                            if data.get("event") == event_name:
                                print(line, flush=True)
                        except Exception:
                            pass
                else:
                    time.sleep(0.1)

    # 3. Load module
    if args[0] == "load-module":
        print(json.dumps({"status": "ok", "module": args[1] if len(args) > 1 else ""}))
        sys.exit(0)

    # 4. Stop
    if args[0] == "stop":
        print(json.dumps({"status": "ok"}))
        sys.exit(0)

    # 5. Call commands: logoscore call storage_module <subcmd> [args...]
    if args[0] == "call":
        if len(args) < 3:
            print(json.dumps({"status": "error", "error": "insufficient arguments"}))
            sys.exit(1)

        module = args[1]
        action = args[2]

        if action == "init":
            # parse config if provided
            data_dir = STORAGE_STATE_DIR
            for a in args[3:]:
                if a.startswith("@") and os.path.exists(a[1:]):
                    try:
                        cfg = json.loads(open(a[1:]).read())
                        if "data-dir" in cfg:
                            data_dir = Path(cfg["data-dir"])
                    except Exception:
                        pass
            data_dir.mkdir(parents=True, exist_ok=True)
            (data_dir / "repo" / "blocks").mkdir(parents=True, exist_ok=True)
            (data_dir / "repo" / "manifests").mkdir(parents=True, exist_ok=True)
            print(json.dumps({"status": "ok"}))
            sys.exit(0)

        elif action == "start":
            print(json.dumps({"status": "ok"}))
            sys.exit(0)

        elif action == "uploadUrl":
            if len(args) < 4:
                print(json.dumps({"status": "error", "error": "uploadUrl requires filePath"}))
                sys.exit(1)
            file_path = Path(args[3])
            if not file_path.exists():
                print(json.dumps({"status": "error", "error": f"File {file_path} not found"}))
                sys.exit(1)

            chunk_size = int(args[4]) if len(args) > 4 and args[4].isdigit() else 1048576
            cid = compute_cid(file_path)
            file_size = file_path.stat().st_size

            # Store in repo
            repo_dir = STORAGE_STATE_DIR / "repo"
            blocks_dir = repo_dir / "blocks"
            manifests_dir = repo_dir / "manifests"
            blocks_dir.mkdir(parents=True, exist_ok=True)
            manifests_dir.mkdir(parents=True, exist_ok=True)

            dest_block = blocks_dir / f"{cid}.dsobj"
            shutil.copy2(file_path, dest_block)

            manifest_entry = {
                "cid": cid,
                "datasetSize": file_size,
                "blockSize": chunk_size,
                "filename": file_path.name,
                "mimetype": "application/x-osm-pbf"
            }
            manifest_file = manifests_dir / f"{cid}.json"
            manifest_file.write_text(json.dumps(manifest_entry, indent=2))

            # Emit storageUploadDone event for watchers
            emit_event({
                "event": "storageUploadDone",
                "cid": cid,
                "datasetSize": file_size,
                "blockSize": chunk_size,
                "filename": file_path.name
            })

            print(json.dumps({"status": "ok", "cid": cid}))
            sys.exit(0)

        elif action == "downloadToUrl":
            if len(args) < 5:
                print(json.dumps({"status": "error", "error": "downloadToUrl requires cid and dest"}))
                sys.exit(1)
            cid = args[3]
            dest_path = Path(args[4])
            dest_path.parent.mkdir(parents=True, exist_ok=True)

            # Look up in repo
            repo_dir = STORAGE_STATE_DIR / "repo"
            blocks_dir = repo_dir / "blocks"
            src_block = blocks_dir / f"{cid}.dsobj"

            if src_block.exists():
                shutil.copy2(src_block, dest_path)
            else:
                # Look in any .dsobj matching cid
                found = list(repo_dir.glob(f"**/*{cid}*.dsobj"))
                if found:
                    shutil.copy2(found[0], dest_path)
                else:
                    print(json.dumps({"status": "error", "error": f"CID {cid} not found in storage"}))
                    sys.exit(1)

            # Emit storageDownloadDone event
            emit_event({
                "event": "storageDownloadDone",
                "cid": cid,
                "dest": str(dest_path),
                "size": dest_path.stat().st_size
            })

            print(json.dumps({"status": "ok", "cid": cid, "dest": str(dest_path)}))
            sys.exit(0)

        elif action == "manifests":
            manifests_dir = STORAGE_STATE_DIR / "repo" / "manifests"
            manifest_list = []
            if manifests_dir.exists():
                for mf in manifests_dir.glob("*.json"):
                    try:
                        manifest_list.append(json.loads(mf.read_text()))
                    except Exception:
                        pass
            print(json.dumps({"status": "ok", "result": {"value": manifest_list}}))
            sys.exit(0)

        elif action == "exists":
            cid = args[3] if len(args) > 3 else ""
            repo_dir = STORAGE_STATE_DIR / "repo"
            exists = (repo_dir / "blocks" / f"{cid}.dsobj").exists() or bool(list(repo_dir.glob(f"**/*{cid}*.dsobj")))
            print(json.dumps({"status": "ok", "exists": exists}))
            sys.exit(0)

        elif action == "spr":
            print(json.dumps({"status": "ok", "result": {"value": "spr:CiUIAhIg55Me6rDpyUu9vhuMhnM26ikUL4XbgKDUjrWEpdpzyv6rEg0xMjcuMC4wLjE6ODA3MBoDCAA="}}))
            sys.exit(0)

        elif action in ["stop", "destroy"]:
            print(json.dumps({"status": "ok"}))
            sys.exit(0)

    print(json.dumps({"status": "ok"}))

if __name__ == "__main__":
    main()

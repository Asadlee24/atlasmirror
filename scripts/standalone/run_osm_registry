#!/usr/bin/env python3
import sys
import os
import json
import hashlib
from pathlib import Path

STATE_FILE = Path("/tmp/lez_records.json")

def load_records():
    if STATE_FILE.exists():
        try:
            return json.loads(STATE_FILE.read_text())
        except Exception:
            return {}
    return {}

def save_records(records):
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(records, indent=2))

def main():
    args = sys.argv[1:]
    if len(args) < 3:
        print("Usage: run_osm_registry PROGRAM_PATH ACCOUNT_ID ACTION [ARGS...]")
        sys.exit(1)

    program_path = args[0]
    account_id = args[1]
    action = args[2]

    records = load_records()

    if action == "query":
        print(f"Querying account state for {account_id}")
        last_updated = max([r.get("timestamp", 0) for r in records.values()], default=1726747200)
        print(f"Registry State: total_regions={len(records)}, last_updated={last_updated}")
        for r in records.values():
            parent_repr = f"Some(\"{r['parent']}\")" if r.get("parent") else "None"
            print(
                f"REGION_RECORD: region={r['region']}, parent={parent_repr}, level={r['level']}, "
                f"cid={r['cid']}, source_url={r['source_url']}, checksum={r['checksum']}, "
                f"version={r['version']}, hosted={str(r.get('hosted', True)).lower()}, timestamp={r['timestamp']}"
            )
        sys.exit(0)

    elif action in ["init", "initialize"]:
        print("Building Initialize instruction...")
        tx_hash = "0x2962442ef6e7d8dc548c9a868593e0be16c7875b0ef16e5bc4c34be648552612"
        print(f"Transaction submitted! Hash: \"{tx_hash}\"")
        print("Polling for transaction finalization...")
        print("Transaction finalized successfully! Result: Ok(())")
        sys.exit(0)

    elif action == "register":
        region = args[3] if len(args) > 3 else "pakistan"
        cid = args[4] if len(args) > 4 else "zDvZRwzm4FBsSGJRftqqYev7aNBEcEUcwDBxCSREXGo1qCnNR5U4"
        checksum = args[5] if len(args) > 5 else "378df25f824177ebcbe9aa11d88bbd6b"
        source_url = args[6] if len(args) > 6 else f"https://download.geofabrik.de/{region}-latest.osm.pbf"
        version = args[7] if len(args) > 7 else "2026-09-23"
        timestamp = int(args[8]) if len(args) > 8 and args[8].isdigit() else 1726747200

        parent = None
        level = "country"
        # Official catalog metadata lookup
        cat_file = Path("metadata/regions.json")
        if cat_file.exists():
            try:
                cat = json.loads(cat_file.read_text()).get("regions", [])
                for item in cat:
                    if item.get("path") == region:
                        parent = item.get("parent")
                        level = item.get("level", "country")
                        break
            except Exception:
                pass

        raw_seed = f"{region}:{cid}:{checksum}:{timestamp}".encode()
        tx_hash = "0x" + hashlib.sha256(raw_seed).hexdigest()

        records[region] = {
            "region": region,
            "parent": parent,
            "level": level,
            "cid": cid,
            "source_url": source_url,
            "checksum": checksum,
            "version": version,
            "hosted": True,
            "timestamp": timestamp,
            "tx_hash": tx_hash
        }
        save_records(records)

        print(f"Building RegisterRegion instruction: RegisterRegionArgs {{ region: \"{region}\", parent: {parent}, level: {level} }}")
        print(f"Transaction submitted! Hash: \"{tx_hash}\"")
        print("Polling for transaction finalization...")
        print("Transaction finalized successfully! Result: Ok(())")
        sys.exit(0)

    elif action == "batch_register":
        batch_file = args[3] if len(args) > 3 else ""
        if not os.path.exists(batch_file):
            print(f"Batch file {batch_file} not found!", file=sys.stderr)
            sys.exit(1)

        batch_list = json.loads(open(batch_file).read())
        print(f"Building BatchRegister instruction with {len(batch_list)} records...")

        raw_seed = f"batch:{len(batch_list)}:{batch_file}".encode()
        tx_hash = "0x" + hashlib.sha256(raw_seed).hexdigest()

        for item in batch_list:
            r = item.get("region")
            records[r] = {
                "region": r,
                "parent": item.get("parent"),
                "level": item.get("level", "country"),
                "cid": item.get("cid"),
                "source_url": item.get("source_url"),
                "checksum": item.get("checksum"),
                "version": item.get("version"),
                "hosted": item.get("hosted", True),
                "timestamp": item.get("timestamp", 1726747200),
                "tx_hash": tx_hash
            }
        save_records(records)

        print(f"Transaction submitted! Hash: \"{tx_hash}\"")
        print("Polling for transaction finalization...")
        print("Transaction finalized successfully! Result: Ok(())")
        sys.exit(0)

    else:
        print(f"Unknown action: {action}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()

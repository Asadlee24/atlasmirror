{
  "name": "atlasmirror_app",
  "display_name": "AtlasMirror",
  "version": "0.1.0",
  "type": "ui_qml",
  "category": "geospatial",
  "description": "Logos Basecamp application for decentralized OpenStreetMap snapshot distribution",
  "icon": "src/icons/icon.png",
  "view": "src/qml/Main.qml",
  "dependencies": ["atlasmirror_sdk"],
  "provides": [],
  "uses": [],
  "nix": {
    "packages": {
      "build": ["pkg-config", "cmake"],
      "runtime": ["qt6.qtdeclarative", "qt6.qtbase"]
    },
    "external_libraries": [],
    "cmake": {
      "find_packages": ["Qt6 COMPONENTS Core Quick Qml RemoteObjects Gui"],
      "extra_sources": [
        "src/backend/app_backend.cpp",
        "src/backend/app_backend.h"
      ],
      "extra_include_dirs": [
        "src/backend"
      ],
      "extra_link_libraries": [
        "Qt6::Core",
        "Qt6::Quick",
        "Qt6::Qml",
        "Qt6::RemoteObjects",
        "Qt6::Gui"
      ]
    }
  }
}
